{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "packages/BE",
  "sourceRoot": "packages/BE/src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "packages/BE/",
      "entryFile": "main",
      "sourceRoot": "packages/BE/src"
    }
  }
}
